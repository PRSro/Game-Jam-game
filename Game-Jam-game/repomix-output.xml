using UnityEngine;
using UnityEngine.UI;
using UnityEngine.EventSystems;
using System.Collections;
using System.Collections.Generic;
using System.Linq;

public class GameUIManager : MonoBehaviour
{
    public static GameUIManager Instance { get; private set; }

    static readonly Color Ink       = new Color(0.05f, 0.03f, 0.02f);
    static readonly Color Darkest   = new Color(0.10f, 0.05f, 0.02f);
    static readonly Color Dark      = new Color(0.16f, 0.08f, 0.02f);
    static readonly Color Med       = new Color(0.24f, 0.11f, 0.03f);
    static readonly Color Gold      = new Color(0.83f, 0.65f, 0.22f);
    static readonly Color Parchment = new Color(0.91f, 0.86f, 0.78f);
    static readonly Color Rust      = new Color(0.45f, 0.25f, 0.10f);
    static readonly Color DimGold   = new Color(0.55f, 0.40f, 0.08f);
