                                     new Color(0.35f, 0.45f, 0.60f), new Vector2(0.70f, 0.65f), new Vector2(0.96f, 0.80f)).GetComponent<Text>();
        Text goldText = MakeUIText(factionPanelPrefab.transform, "GoldText", 8, FontStyle.Normal,
